{
  "name": "omniemu",
  "private": true,
  "version": "0.18.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run core:build && vite",
    "check": "tsc --noEmit",
    "core:fmt": "node scripts/core-task.mjs fmt",
    "core:clippy": "node scripts/core-task.mjs clippy",
    "core:test": "node scripts/core-task.mjs test",
    "core:build": "node scripts/core-task.mjs build",
    "core:smoke": "node scripts/wasm-smoke.mjs",
    "build": "npm run core:build && npm run core:smoke && tsc && vite build",
    "preview": "vite preview",
    "verify:branding": "node scripts/verify-branding.mjs",
    "verify": "npm run verify:branding && npm run core:fmt && npm run core:clippy && npm run core:test && npm run build"
  },
  "devDependencies": {
    "coi-serviceworker": "^0.1.7",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
